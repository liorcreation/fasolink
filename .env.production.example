# ═══════════════════════════════════════════════════════════════════════════════
# FasoLink — Variables d'environnement PRODUCTION
# ═══════════════════════════════════════════════════════════════════════════════
# Ce fichier liste TOUTES les variables nécessaires au déploiement public.
# NE JAMAIS committer ce fichier renseigné dans le dépôt Git.
# Placez les valeurs dans les Secrets de Cloudflare Workers / Vercel.
#
# ── LÉGENDE ──
#   🔑  Secret (ne JAMAIS exposer côté client)
#   🌐  Publique (préfixée NEXT_PUBLIC_, visible dans le bundle JS)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Firebase (Public Config) ────────────────────────────────────────────── 🌐
# Console Firebase → Project settings → General → Your apps → SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=fasolink-d6e77.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fasolink-d6e77
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=fasolink-d6e77.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=979555094870
NEXT_PUBLIC_FIREBASE_APP_ID=1:979555094870:web:93a4046918f870e741c6f7

# ─── URL publique de l'application ───────────────────────────────────────── 🌐
# Doit correspondre au domaine configuré dans Firebase Auth + CinetPay
NEXT_PUBLIC_SITE_URL=https://fasolink.bf

# ─── URL serveur (pour les webhooks CinetPay et les API routes) ──────────── 🔑
APP_BASE_URL=https://fasolink.bf

# ─── CinetPay — Passerelle de paiement Mobile Money ─────────────────────── 🔑
# Compte marchand CinetPay → Paramètres → API
# NE JAMAIS préfixer par NEXT_PUBLIC_
CINETPAY_API_KEY=votre-clef-api-marchand-cinetpay
CINETPAY_SITE_ID=votre-site-id-cinetpay

# ─── Firebase Admin SDK (Service Account) ────────────────────────────────── 🔑
# Console Firebase → Project settings → Service accounts → Generate new key
# Collez le JSON complet sur UNE SEULE LIGNE.
# Utilisé par les API routes serveur (webhooks, cron, trial, initialize).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"fasolink-d6e77","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@fasolink-d6e77.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# ─── Secret pour le CRON d'expiration ────────────────────────────────────── 🔑
# Partagé entre le worker cron et l'API /api/cron/expire
CRON_SECRET=un-secret-long-et-aleatoire-generer-avec-openssl-rand

# ─── Pexels (images de substitution) ────────────────────────────────────── 🔑
# Optionnel — utilisé par /api/images/search pour les images placeholder
PEXELS_API_KEY=votre-clef-api-pexels

# ═══════════════════════════════════════════════════════════════════════════════
# VARIABLES SPÉCIFIQUES CLOUDFLARE WORKERS
# (à configurer dans wrangler secret ou le Dashboard Cloudflare)
# ═══════════════════════════════════════════════════════════════════════════════
# Toutes les variables 🔑 ci-dessus doivent être ajoutées comme secrets :
#   wrangler secret put CINETPAY_API_KEY
#   wrangler secret put CINETPAY_SITE_ID
#   wrangler secret put FIREBASE_SERVICE_ACCOUNT
#   wrangler secret put CRON_SECRET
#   wrangler secret put PEXELS_API_KEY
#
# Les variables 🌐 peuvent être dans [vars] du wrangler.jsonc ou en secrets.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Worker Cron (workers/wrangler.toml) ─────────────────────────────────────
# API_URL = https://fasolink.bf      ← dans [vars]
# CRON_SECRET                        ← dans secrets du worker cron
