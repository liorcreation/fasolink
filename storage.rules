rules_version = '2';

// Règles Firebase Storage — FasoLink
// Déploiement : firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.superAdmin == true;
    }

    // Logos & photos produits : shops/<shopId>/<fichier>
    match /shops/{shopId}/{fileName} {
      allow read: if true;
      allow write: if ((request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/(default)/documents/shops/$(shopId))
        && get(/databases/(default)/documents/shops/$(shopId)).data.owner_id == request.auth.uid
        && get(/databases/(default)/documents/shops/$(shopId)).data.status != 'suspended')
        || isSuperAdmin())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if (request.auth != null
        && exists(/databases/(default)/documents/shops/$(shopId))
        && get(/databases/(default)/documents/shops/$(shopId)).data.owner_id == request.auth.uid)
        || isSuperAdmin();
    }

    // Pièces d'identité : aucun accès public.
    match /verification_requests/{ownerId}/{requestId}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == ownerId || isSuperAdmin());
      allow write: if request.auth != null
        && request.auth.uid == ownerId
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && (request.auth.uid == ownerId || isSuperAdmin());
    }
  }
}
