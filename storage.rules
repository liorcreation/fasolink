rules_version = '2';

// Règles Firebase Storage — FasoLink
// Déploiement : firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {
    // Logos & photos produits : shops/<shopId>/<fichier>
    match /shops/{shopId}/{fileName} {
      allow read: if true;
      allow write: if ((request.auth != null
        && exists(/databases/(default)/documents/shops/$(shopId))
        && get(/databases/(default)/documents/shops/$(shopId)).data.owner_id == request.auth.uid)
        || (request.auth != null && request.auth.token.admin == true))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if (request.auth != null
        && exists(/databases/(default)/documents/shops/$(shopId))
        && get(/databases/(default)/documents/shops/$(shopId)).data.owner_id == request.auth.uid)
        || (request.auth != null && request.auth.token.admin == true);
    }

    // Pièces d'identité : aucun accès public.
    match /verification_requests/{ownerId}/{requestId}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == ownerId || request.auth.token.admin == true);
      allow write: if request.auth != null
        && request.auth.uid == ownerId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && (request.auth.uid == ownerId || request.auth.token.admin == true);
    }
  }
}
