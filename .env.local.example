# Firebase — copiez ce fichier vers .env.local et renseignez vos clés.
# Console : https://console.firebase.google.com → Project settings → General
# → « Your apps » → Web app → SDK setup and configuration.
#
# Prérequis côté projet Firebase :
#   1. Firestore Database : créer la base (mode production)
#   2. Authentication → Sign-in method → activer « Anonymous »
#   3. Storage : activer, puis déployer storage.rules
#   4. Déployer firestore.rules et firestore.indexes.json

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=votre-projet
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Webhook Mobile Money (CinetPay / PayDunya) — activation d'abonnement
PAYMENT_WEBHOOK_SECRET=changez-moi

# Seed uniquement (npm run seed) — compte de service Firebase Admin.
# Téléchargez la clé : Console → Project settings → Service accounts →
# « Generate new private key », enregistrez-la sous serviceAccountKey.json
# (déjà git-ignoré) OU collez son contenu JSON sur une ligne ici :
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
