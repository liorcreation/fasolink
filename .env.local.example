# Supabase — copiez ce fichier vers .env.local et renseignez vos clés
# Dashboard : https://app.supabase.com/project/_/settings/api
#
# Prérequis côté projet Supabase :
#  1. Exécuter schema.sql (SQL Editor)
#  2. Auth → Providers → activer « Anonymous sign-ins »
#     (le formulaire vendeur ouvre une session anonyme pour les policies RLS)
#  3. Storage → le bucket public « shop-assets » est créé par schema.sql

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Clé de service (serveur uniquement — ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# Passerelle Mobile Money (CinetPay / PayDunya) — webhook d'activation
# URL à configurer chez l'agrégateur : https://<domaine>/api/webhooks/payment
PAYMENT_WEBHOOK_SECRET=changez-moi
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
